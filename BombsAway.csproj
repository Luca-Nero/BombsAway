<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>

    <!-- MSB3277 = assembly version unification conflicts, thousands of them, from
         referencing MelonLoader's net6 assemblies out of a netstandard2.1 project.
         Nothing to fix; the loader resolves everything itself at runtime. Demoted
         so that a warning about THIS mod's code is visible instead of buried.
         Same reasoning as 2_GunsGunsGuns and 5_FruitLib. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="C4_mesh.json" />
    <None Remove="Car46_mesh.json" />
    <None Remove="Claymore_mesh.json" />
    <None Remove="Javelin_mesh.json" />
    <None Remove="TAG19_mesh.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Meshes\C4_mesh.json" />
    <EmbeddedResource Include="Meshes\Car46_mesh.json" />
    <EmbeddedResource Include="Meshes\Claymore_mesh.json" />
    <EmbeddedResource Include="Meshes\Javelin_mesh.json" />
    <EmbeddedResource Include="Meshes\TAG19_mesh.json" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(CI)' != 'true'">
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;D:\SteamLibrary\steamapps\common\FRUKT Demo\Mods&quot;" />
  </Target>

</Project>
