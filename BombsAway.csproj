<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- Effects/ParticleIO.cs calls il2cpp_runtime_invoke directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- MSB3277 = assembly version unification conflicts, thousands of them, from
         referencing MelonLoader's net6 assemblies out of a netstandard2.1 project.
         Nothing to fix; the loader resolves everything itself at runtime. Demoted
         so that a warning about THIS mod's code is visible instead of buried.
         Same reasoning as 2_GunsGunsGuns and 5_FruitLib. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built in E:\Dev\Unity\BombsAwayBundle (FruitLib > Build Bundles, copy BundlesOut\bombsaway here). -->
    <EmbeddedResource Include="Bundles\bombsaway.bundle" />
    <!-- The terminal's default script; written to UserData\BombsAwayTerminal.txt when that's missing (TerminalScript.cs). -->
    <EmbeddedResource Include="FireSupport\TerminalScript.txt" LogicalName="BombsAway.TerminalScript.txt" />
    <EmbeddedResource Include="Icons\Grenade.png" />
    <EmbeddedResource Include="Icons\C4.png" />
    <EmbeddedResource Include="Icons\Claymore.png" />
    <EmbeddedResource Include="Icons\Javelin.png" />
    <EmbeddedResource Include="Icons\AT4.png" />
    <EmbeddedResource Include="Icons\Category.png" />
    <EmbeddedResource Include="Icons\Flash.png" />
    <EmbeddedResource Include="Icons\Smoke.png" />
    <EmbeddedResource Include="Icons\Binoculars.png" />
  </ItemGroup>

  <!-- Deploy to every live FRUKT install under FruktBuildsRoot (any FRUKT.exe, at any depth, with
       Mods as its sibling). An install carrying DEPRECATED_DONT_BUILD_AGAINST.md next to its FRUKT.exe
       (the old Demo) is skipped. Local only: CI / GitHub Actions have no install, and
       -p:SkipDeploy=true skips it by hand for a compile-only build. -->
  <PropertyGroup>
    <FruktBuildsRoot Condition="'$(FruktBuildsRoot)' == ''">D:\SteamLibrary\steamapps\common</FruktBuildsRoot>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent"
          Condition="'$(CI)' != 'true' And '$(GITHUB_ACTIONS)' != 'true' And '$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <_FruktExe Include="$(FruktBuildsRoot)\**\FRUKT.exe" />
      <FruktInstance Include="@(_FruktExe)"
                     Condition="!Exists('%(RootDir)%(Directory)DEPRECATED_DONT_BUILD_AGAINST.md')" />
    </ItemGroup>
    <Error Condition="'@(FruktInstance)' == ''"
           Text="No live FRUKT instance under '$(FruktBuildsRoot)' (installs marked DEPRECATED_DONT_BUILD_AGAINST.md are skipped). Set FruktBuildsRoot if the game lives elsewhere." />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="%(FruktInstance.RootDir)%(FruktInstance.Directory)Mods" />

    <Message Importance="high"
             Text="BombsAway -&gt; %(FruktInstance.RootDir)%(FruktInstance.Directory)Mods" />
  </Target>

</Project>
